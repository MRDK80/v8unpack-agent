// Synthetic examples for the research taxonomy. Names are invented.
&НаСервере
Процедура ПостроитьПример()
    // Элементы.Добавить("ЛожноеСовпадение", Тип("ПолеФормы"));
    Текст = "Элементы.Удалить(НеОперация)";
    НовыйЭлемент = Элементы.Добавить("ДемоПоле", Тип("ПолеФормы"));
    НовыйЭлемент.ПутьКДанным = "ДемоРеквизит";
    НоваяКоманда = Команды.Добавить("ДемоКоманда");
    НоваяКоманда.Действие = "ОбработчикПримера";
    Элементы.ДемоПоле.Видимость = Истина;
    Если УсловиеПримера Тогда
        Элементы.ДемоПоле.Доступность = Ложь;
    КонецЕсли;
    Для Индекс = 1 По ЧислоПолей Цикл
        Элементы.Добавить("Демо" + Строка(Индекс), Тип("ПолеФормы"));
    КонецЦикла;
    Элементы.Переместить(НовыйЭлемент, Элементы.ДемоГруппа);
    НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОбработчикПримера");
    Вставленный = Элементы.Вставить("ДемоВставка", Тип("ПолеФормы"), Элементы.ДемоГруппа, НовыйЭлемент);
    Вставленный.Ширина = 10;
    Команды.Удалить(НоваяКоманда);
    Элементы.Удалить(НовыйЭлемент);
    Добавляемые = Новый Массив;
    Добавляемые.Добавить(Новый РеквизитФормы("ДемоРеквизит", Новый ОписаниеТипов("Строка")));
    Удаляемые = Новый Массив;
    Удаляемые.Добавить("ДемоУдаляемыйРеквизит");
    ИзменитьРеквизиты(Добавляемые, Удаляемые);
    ПодготовитьЛокально(ЭтаФорма);
    ДемоОбщийМодуль.Подготовить(ЭтаФорма);
КонецПроцедуры

Процедура ПодготовитьЛокально(ФормаПримера)
    ФормаПримера.Элементы.ДемоПоле.Заголовок = "Пример";
КонецПроцедуры
